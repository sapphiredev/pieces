{
	"name": "@sapphire/pieces",
	"version": "5.0.1",
	"description": "Sapphire's piece loader.",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"import": "./dist/index.mjs"
	},
	"author": "@sapphire",
	"license": "MIT",
	"scripts": {
		"lint": "eslint src --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"docs": "typedoc-json-parser",
		"update": "yarn upgrade-interactive",
		"clean": "rimraf dist",
		"test": "vitest run",
		"build": "tsdown",
		"typecheck": "tsc -b src",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"prepack": "yarn build"
	},
	"dependencies": {
		"@discordjs/collection": "^2.1.1",
		"@sapphire/utilities": "^4.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@favware/cliff-jumper": "^6.1.0",
		"@favware/npm-deprecate": "^2.0.0",
		"@sapphire/eslint-config": "^6.0.0",
		"@sapphire/prettier-config": "^3.0.0",
		"@sapphire/ts-config": "^6.0.0",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"@vitest/coverage-v8": "^5.1.1",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.15.0",
		"lint-staged": "^17.6.1",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/pieces.git"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=v14.0.0",
		"npm": ">=7.0.0"
	},
	"keywords": [
		"discordjs",
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/pieces/issues"
	},
	"homepage": "https://www.sapphirejs.dev",
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix --ext mjs,js,ts"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"resolutions": {
		"acorn": "^8.19.0",
		"ansi-regex": "^5.0.1",
		"minimist": "^1.2.8"
	},
	"prettier": "@sapphire/prettier-config",
	"packageManager": "yarn@4.19.0"
}
